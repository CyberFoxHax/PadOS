<?xml version="1.0" encoding="UTF-8"?>
<Profile>
	<ButtonTrigger Button="DPadUp" />
	<KeyboardAction Button="Up" />

  <ButtonTrigger Button="DPadDown" />
  <KeyboardAction Button="Down" />

  <HoldSwitch>
    <ButtonTrigger Button="LeftThumb" />
  </HoldSwitch>
  <KeyboardAction Button="F1" HoldSwitch.Timeout="0" />
  <KeyboardAction Button="Shift+F1" HoldSwitch.Timeout="500" />

  <HoldSwitch>
    <ButtonTrigger Button="RightThumb" />
  </HoldSwitch>
  <KeyboardAction Button="Alt+Tab" HoldSwitch.Timeout="0" />
  <KeyboardAction Button="Alt+F4" HoldSwitch.Timeout="1000" />
</Profile>